rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Bookings collection (Real-time sync between Mobile App and Web Admin)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // 3. Diagnostic Reports collection (NABL verified PDF & image reports)
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 4. Notifications & Reminders
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 5. Promotional Banners & Diagnostic Catalog
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    match /catalog/{serviceId} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Global fallback for live cloud sync
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
